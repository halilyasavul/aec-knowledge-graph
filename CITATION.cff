repository-code: "https://github.com/halilyasavul/aec-knowledge-graph"
license: Apache-2.0
version: 0.1.0
date-released: "2026-08-30"
keywords:
  - IFC
  - knowledge graph
  - GraphRAG
  - semantic interoperability
  - digital twin
  - BIM
  - IDS
  - Neo4j
