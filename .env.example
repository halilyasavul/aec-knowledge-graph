# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# UCKS library storage: "local" keeps each visitor's defined entities in
# their own browser (public-demo default); "graph" saves YAML server-side
# and ingests into Neo4j (shared library for single-team deployments)
UCKS_STORAGE=local

# Security — set a random secret to protect API endpoints
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=

# UI access token — when set, users must visit /?token=YOUR_TOKEN to access the UI
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
UI_ACCESS_TOKEN=

# Admin token — required for destructive endpoints (/api/ucks/clear).
# Leave empty to disable those endpoints entirely.
ADMIN_TOKEN=

ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=30
CHAT_RATE_LIMIT_PER_MINUTE=5
CHAT_DAILY_CAP=500
MAX_CHAT_MESSAGE_LENGTH=2000

# Server
PORT=8080
